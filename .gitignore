# R session artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj

# renv
renv/library/
renv/staging/

# Logs (regenerated each run)
code/logs/*
!code/logs/.gitkeep

# Results (regenerated by scripts — commit selectively if desired)
results/tables/*
results/statistics/*
!results/tables/.gitkeep
!results/tables/*.csv
!results/tables/*.tex
!results/statistics/.gitkeep

# Large / sensitive raw data
data/clean/*
!data/clean/.gitkeep
data/processed/*
!data/processed/.gitkeep

# macOS
.DS_Store

# Credentials and secrets
.env
*.pem
*.key
secrets/
