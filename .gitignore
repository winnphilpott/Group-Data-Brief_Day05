# R session artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj

# renv
renv/library/
renv/staging/

# Logs (regenerated each run)
code/logs/*
!code/logs/.gitkeep

# Output (regenerated by scripts — commit selectively if desired)
output/tables/*
output/statistics/*
!output/tables/.gitkeep
!output/tables/*.csv
!output/tables/*.tex
!output/statistics/.gitkeep

# Large / sensitive raw data
data/raw/*
!data/raw/.gitkeep
!data/raw/*.csv
data/processed/*
!data/processed/.gitkeep
!data/processed/*.csv

# macOS
.DS_Store

# Credentials and secrets
.env
*.pem
*.key
secrets/
